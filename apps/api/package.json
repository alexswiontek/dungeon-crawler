{
  "name": "@dungeon-crawler/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/domain/dist --watch ../../packages/protocol/dist --ext ts,js --exec tsx src/index.ts",
    "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-paths",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:integration": "RUN_MONGODB_INTEGRATION=1 RUN_REDIS_INTEGRATION=1 RUN_WEBSOCKET_NETWORK_INTEGRATION=1 vitest run src/services/gameCommandService.mongodb.test.ts src/services/gameJournal.redis.test.ts src/routes/gameWebSocket.test.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "benchmark:commands": "node benchmarks/movementBenchmark.mjs http",
    "benchmark:websocket": "node benchmarks/movementBenchmark.mjs websocket"
  },
  "dependencies": {
    "@dungeon-crawler/domain": "workspace:*",
    "@dungeon-crawler/protocol": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "11.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "mongodb": "^7.6.0",
    "obscenity": "^0.4.6",
    "pino": "^10.3.1",
    "redis": "^5.12.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "ws": "8.21.3"
  }
}
