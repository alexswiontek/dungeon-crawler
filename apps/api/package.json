{
  "name": "@dungeon-crawler/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/shared/src --ext ts --exec tsx src/index.ts",
    "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-paths",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_MONGODB_INTEGRATION=1 vitest run src/services/gameCommandService.mongodb.test.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dungeon-crawler/domain": "workspace:*",
    "@dungeon-crawler/protocol": "workspace:*",
    "@dungeon-crawler/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^6.1.0",
    "mongodb": "^6.3.0",
    "obscenity": "^0.4.5",
    "pino": "^10.3.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
