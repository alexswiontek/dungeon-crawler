{
  "extends": [
    "./tsconfig.json",
    "../../tsconfig.workspace-source.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@dungeon-crawler/domain/*": [
