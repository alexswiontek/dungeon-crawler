# Server port (default: 3000)
PORT=3000

# MongoDB connection string
# Local: mongodb://localhost:27017/dungeon-crawler
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/dungeon-crawler
MONGODB_URI=mongodb://localhost:27017/dungeon-crawler

# Comma-separated browser origins, where * matches within one hostname label
# Previews: https://dungeon-crawler-ui-*-alexs-projects-19b7b594.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

REDIS_URL=redis://127.0.0.1:6379
