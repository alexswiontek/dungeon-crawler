{
  "name": "@dungeon-crawler/domain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./combat": {
      "types": "./dist/combat.d.ts",
      "import": "./dist/combat.js"
    },
    "./dungeon-generation": {
      "types": "./dist/dungeon-generation.d.ts",
      "import": "./dist/dungeon-generation.js"
    },
    "./enemies": {
      "types": "./dist/enemies.d.ts",
      "import": "./dist/enemies.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./random": {
      "types": "./dist/random.d.ts",
      "import": "./dist/random.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js"
    },
    "./transition": {
      "types": "./dist/transition.d.ts",
      "import": "./dist/transition.js"
    },
    "./visibility": {
      "types": "./dist/visibility.d.ts",
      "import": "./dist/visibility.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
