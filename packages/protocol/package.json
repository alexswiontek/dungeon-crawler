{
  "name": "@dungeon-crawler/protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client-projection": {
      "types": "./dist/client-projection.d.ts",
      "import": "./dist/client-projection.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dungeon-crawler/domain": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
